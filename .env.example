# Copy this file to .env and fill in your values. Never commit .env.

# Bot token from the Discord Developer Portal (required)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Prefix for typed commands (default: /)
DISCORD_BOT_PREFIX=/

# Folder with music files, scanned with subfolders (default: music)
DISCORD_BOT_MUSIC_SOURCE_FOLDER=music

# Audio bitrate sent to Discord in kbps (default: 96)
# Other options: 128 (higher quality, more traffic), 64 (less traffic, lower quality)
DISCORD_BOT_BITRATE=96

# Print every chat message the bot sees to the console (default: false)
DISCORD_BOT_DEBUG=false
